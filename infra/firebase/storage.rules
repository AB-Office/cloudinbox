rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // mail-data/{uid}/{messageId}/** パスのアクセス制御
    // 認証ユーザーのみ、自分のuidに一致するパスのみ読み書き削除可能
    match /mail-data/{uid}/{messageId}/{allPaths=**} {
      // 読み取り: 認証ユーザーが自分のuidに一致する場合のみ
      allow read: if request.auth != null && request.auth.uid == uid;
      
      // 書き込み: 認証ユーザーが自分のuidに一致する場合のみ
      allow write: if request.auth != null && request.auth.uid == uid;
      
      // 削除: 認証ユーザーが自分のuidに一致する場合のみ
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}

