rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザードキュメント: 認証ユーザーのみ読み書き可能
    // legalConsentsフィールドを含むすべてのフィールド（plan, usage, billing等）の読み書きを許可
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // メールアカウントサブコレクション: 認証ユーザーのみ読み書き可能
      match /mailAccounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      
      // メールスレッドサブコレクション: 認証ユーザーのみ読み書き可能
      match /mailThreads/{threadId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      
      // メールメッセージサブコレクション: 認証ユーザーのみ読み書き可能
      match /mailMessages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      
      // メール送信タスク結果サブコレクション: 認証ユーザーのみ読み取り可能、書き込みはCloud Functionsからのみ（クライアント側からの書き込みは不可）
      match /mailTaskResults/{taskId} {
        // 読み取り: 認証ユーザーが自分のuidに一致する場合のみ許可
        allow read: if request.auth != null && request.auth.uid == uid;
        // 書き込み: クライアント側からの書き込みは禁止（Cloud FunctionsのAdmin SDKはセキュリティルールをバイパスするため、実質的にCloud Functionsからのみ書き込み可能）
        allow write: if false;
      }
    }
    
    // collectionGroupクエリ用: mailMessagesコレクション全体を横断検索する場合
    // 各ドキュメントにuidフィールドが含まれていることを前提とする
    match /{path=**}/mailMessages/{messageId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // collectionGroupクエリ用: mailThreadsコレクション全体を横断検索する場合
    // 各ドキュメントにuidフィールドが含まれていることを前提とする
    match /{path=**}/mailThreads/{threadId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}

