{
  "name": "cloudinbox-functions",
  "version": "1.8.1",
  "description": "CloudInbox MVP - Cloud Functions for POP3 mail reception and cloud storage",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:smtp": "ts-node test/smtp-test.ts"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/kms": "^3.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/tasks": "^3.0.0",
    "@noble/ciphers": "^1.0.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "mailbuild": "^0.3.7",
    "mailparser": "^3.6.5",
    "nodemailer": "^7.0.11",
    "quoted-printable": "^1.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.21",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "private": true
}
